        },
        "kind": {
          "type": "string",
          "enum": [
            "relativeToStart",
            "relativeToEnd",
            "absolute"
          ]
        },
        "offsetMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "description": "负数 = 提前；kind 为相对时必填"
        },
        "absoluteDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "absoluteMinute": {
          "type": [
            "integer",
            "null"
          ]
        },
        "isEnabled": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "createdAt": {
          "type": "integer",
          "description": "Instant ms，创建后不变"
        },
        "updatedAt": {
          "type": "integer",
          "description": "Instant ms，每次本地写入更新"
        },
        "deletedAt": {
          "type": [
            "integer",
            "null"
          ],
          "description": "非空即墓碑"
        },
