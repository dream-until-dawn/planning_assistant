        "taskId",
        "kind",
        "isEnabled",
        "createdAt",
        "updatedAt",
        "revision",
        "lastWriterId"
      ],
      "additionalProperties": false
    },
    "setting": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "valueJson": {
          "type": "string",
          "contentMediaType": "application/json",
          "description": "**二次编码**：本身是 JSON 字符串，解析时需再 JSON.parse 一次。"
        },
        "scope": {
          "type": "string",
          "enum": [
            "global"
          ],
          "description": "导出只含 global；device 域不同步不导出"
        },
        "createdAt": {
          "type": "integer",
          "description": "Instant ms，创建后不变"
        },
        "updatedAt": {
          "type": "integer",
          "description": "Instant ms，每次本地写入更新"
        },
        "deletedAt": {
          "type": [
            "integer",
            "null"
          ],
          "description": "非空即墓碑"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "lastWriterId": {
