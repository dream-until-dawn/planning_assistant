      ],
      "additionalProperties": false
    },
    "occurrenceOverride": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "occurrenceKey": {
          "type": "string",
          "description": "**原始**发生时刻的墙钟串。全天任务为纯日期，定时任务形如 yyyy-MM-ddTHH:mm"
        },
        "action": {
          "type": "string",
          "enum": [
            "skip",
            "modify"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "completedAt": {
          "type": [
            "integer",
            "null"
          ]
        },
        "titleOverride": {
          "type": [
            "string",
            "null"
          ]
        },
        "noteOverride": {
          "type": [
            "string",
            "null"
          ]
        },
        "planDateOverride": {
          "type": [
            "string",
            "null"
          ]
        },
        "startMinuteOverride": {
          "type": [
            "integer",
            "null"
          ]
        },
        "endDateOverride": {
          "type": [
            "string",
            "null"
          ]
        },
        "endMinuteOverride": {
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "type": "integer",
          "description": "Instant ms，创建后不变"
        },
        "updatedAt": {
          "type": "integer",
          "description": "Instant ms，每次本地写入更新"
        },
        "deletedAt": {
          "type": [
            "integer",
            "null"
          ],
          "description": "非空即墓碑"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "lastWriterId": {
          "type": "string"
        },
        "remoteVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "V1 恒为 null"
        }
      },
      "required": [
        "id",
        "taskId",
        "occurrenceKey",
        "action",
        "createdAt",
        "updatedAt",
        "revision",
        "lastWriterId"
      ],
      "additionalProperties": false
    },
    "stageOccurrenceState": {
